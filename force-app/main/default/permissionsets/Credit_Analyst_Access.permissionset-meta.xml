<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Credit Analyst Access</label>
    <description>Permite al perfil Analista de Crédito ver el resultado del descuento y del scoring en Opportunity. Lectura de los campos de la funcionalidad y edición de los dos que escribe el job de scoring.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Customer_Segment__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Opportunity.Discount__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Opportunity.Credit_Score__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Opportunity.Credit_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Opportunity.Vehicle_Count__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
